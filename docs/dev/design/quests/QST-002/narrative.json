  "information": [
    {
      "id": "QST-002-I001",
      "proposition": "米娜希望在离城前处理玩具反复移位",
      "world_truth": "米娜是求助者、受影响者和梦主；目标是继续自己的生活",
      "importance": "critical",
      "initial_state": "hidden"
    },
    {
      "id": "QST-002-I002",
      "proposition": "玩具在现实中被抹除或凭空消失",
      "world_truth": "错误解释；物件仍在附近周转箱或柜底夹层，数量与路径可核对",
      "importance": "supporting",
      "initial_state": "hidden"
    },
    {
      "id": "QST-002-I003",
      "proposition": "实物沿柜内既有路径移动，数量没有增加或减少",
      "world_truth": "异常介质导致局部机械扰动，梦中复制不等于现实复制",
      "importance": "critical",
      "initial_state": "hidden"
    },
    {
      "id": "QST-002-I004",
      "proposition": "收集者只会偷走玩具",
      "world_truth": "错误解释；归还与送出属于同一运输过程，它不是必须清除的目标",
      "importance": "critical",
      "initial_state": "hidden"
    },
    {
      "id": "QST-002-I005",
      "proposition": "运输被退回或阻断时，保留室副本持续堆积",
      "world_truth": "出口翻板将箱子退回保留室，隔离收集者进一步降低送出能力",
      "importance": "critical",
      "initial_state": "hidden"
    },
    {
      "id": "QST-002-I006",
      "proposition": "现实新位移来自柜体局部输出点",
      "world_truth": "有限供能与柜体输出联系支持扰动；需先创造低扰动窗口再由清醒接应隔离",
      "importance": "critical",
      "initial_state": "hidden"
    },
    {
      "id": "QST-002-I007",
      "proposition": "有害输出联系已经隔离",
      "world_truth": "只有梦中一轮运输完成且现实接应确认隔离，才提交处理结果",
      "importance": "critical",
      "initial_state": "hidden"
    },
    {
      "id": "QST-002-I008",
      "proposition": "米娜决定哪些物件随身、留存或寄售",
      "world_truth": "异常处理不以强迫米娜丢弃物件或改变感情为条件",
      "importance": "critical",
      "initial_state": "hidden"
    }
  ],
