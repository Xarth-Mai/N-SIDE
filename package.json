{
  "name": "n-side",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "bun --bun vitepress dev docs",
    "docs:build": "bun install --frozen-lockfile && bun --bun vitepress build docs",
    "docs:preview": "bun --bun vitepress preview docs",
    "check:docs": "python3 -B tools/validate_docs.py --root .",
    "check:narrative": "python3 -B tools/validate_narrative.py --root .",
    "check:templates": "python3 -B tools/validate_narrative.py --file docs/templates/narrative.json",
    "test:tools": "python3 -B -m unittest discover -s tools/tests -p 'test_*.py' && bun test tools/tests/wiki.test.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "packageManager": "bun@1.4.2"
}
