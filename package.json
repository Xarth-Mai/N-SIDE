{
  "name": "n-side",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "bun tools/wiki.mjs dev dev",
    "docs:build": "bun install --frozen-lockfile && bun run check:map && bun run docs:build:player && bun run docs:build:dev",
    "docs:preview": "bun tools/wiki.mjs preview dev",
    "check:docs": "python3 -B tools/validate_docs.py --root . && bun run check:skills",
    "check:narrative": "python3 -B tools/validate_narrative.py --root .",
    "check:story-design": "python3 -B tools/validate_story_design.py --root .",
    "check:templates": "python3 -B tools/validate_narrative.py --file docs/dev/handbook/templates/narrative.json",
    "test:tools": "python3 -B -m unittest discover -s tools/tests -p 'test_*.py' && bun test tools/tests",
    "check:map": "bun test tools/tests/district-map.test.mjs",
    "roadmap": "python3 -B tools/roadmap.py --root .",
    "roadmap:sync": "python3 -B tools/roadmap.py --root . --write",
    "check:roadmap": "python3 -B tools/roadmap.py --root . --check",
    "check:skills": "bun tools/validate-skills.mjs",
    "capture": "python3 tools/capture.py",
    "check:skills:upstream": "python3 tools/check_skill_upstream.py --output output/skills/upstream.json",
    "docs:dev:player": "bun tools/wiki.mjs dev player",
    "docs:dev:dev": "bun tools/wiki.mjs dev dev",
    "docs:build:player": "bun tools/wiki.mjs build player",
    "docs:build:dev": "bun tools/wiki.mjs build dev",
    "docs:preview:player": "bun tools/wiki.mjs preview player",
    "docs:preview:dev": "bun tools/wiki.mjs preview dev"
  },
  "devDependencies": {
    "delaunator": "5.0.1",
    "vitepress": "^1.6.4"
  },
  "packageManager": "bun@1.4.2"
}
