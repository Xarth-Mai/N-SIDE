+                            let b = Vec2::new(b[0] as f32, -b[1] as f32);
+                            let tangent = (b - a).normalize();
+                            let normal = Vec2::new(-tangent.y, tangent.x);
+                            cube.iter().all(|p| {
+                                let offset = Vec2::new(p[0], p[2]) - a;
