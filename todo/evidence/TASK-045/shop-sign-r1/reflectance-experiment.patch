+    #[test]
+    fn appearance_reflectance_defaults_and_validates_boundaries() {
+        let dir = TestDir::new();
+        let path = dir.0.join("appearance.json");
+        let mut document = serde_json::json!({
+            "version":1,
+            "materials":{"wall":{"color":[1,1,1,1],"roughness":0.8,"tile_meters":[1,1]}},
+            "models":{}, "shopfronts":{}
+        });
+        let parsed: MaterialSpec =
+            serde_json::from_value(document["materials"]["wall"].clone()).unwrap();
+        assert_eq!(parsed.reflectance, StandardMaterial::default().reflectance);
+        std::fs::write(&path, document.to_string()).unwrap();
+        assert_eq!(
+            Appearance::load(&path).unwrap().materials["wall"].reflectance,
+            0.5
+        );
+        for value in [0.0, 0.2, 0.5, 1.0] {
+            document["materials"]["wall"]["reflectance"] = serde_json::json!(value);
+            std::fs::write(&path, document.to_string()).unwrap();
+            assert_eq!(
+                Appearance::load(&path).unwrap().materials["wall"].reflectance,
+                value as f32
+            );
+        }
+        for value in [-0.001, 1.001, -1e99, 1e99] {
+            document["materials"]["wall"]["reflectance"] = serde_json::json!(value);
+            std::fs::write(&path, document.to_string()).unwrap();
+            let error = Appearance::load(&path).unwrap_err();
+            assert!(
+                error.contains("appearance.json")
+                    && error.contains("/materials/wall/reflectance")
+                    && error.contains("finite 0..=1"),
+                "{error}"
+            );
+        }
+        for value in [serde_json::Value::Null, serde_json::json!("NaN")] {
+            document["materials"]["wall"]["reflectance"] = value;
+            std::fs::write(&path, document.to_string()).unwrap();
+            let error = Appearance::load(&path).unwrap_err();
+            assert!(
+                error.contains("[appearance/parse]") && error.contains("reflectance"),
+                "{error}"
+            );
+        }
+    }
