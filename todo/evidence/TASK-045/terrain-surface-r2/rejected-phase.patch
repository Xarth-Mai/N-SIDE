+//! Only natural ground needs nonperiodic sampling; the rest of the city uses StandardMaterial
+use bevy::{
+    pbr::{ExtendedMaterial, MaterialExtension},
+    prelude::*,
+    render::render_resource::AsBindGroup,
+    shader::ShaderRef,
+};
+
+pub(super) const SHADER: &str = "shaders/terrain-ground.wgsl";
+pub(super) type TerrainMaterial = ExtendedMaterial<StandardMaterial, TerrainSurface>;
+
+#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
+pub(super) struct TerrainSurface {
+    // Keep the same source pair and sampler in both color and normal prepasses
+    #[uniform(100)]
+    pub enabled: Vec4,
+    #[texture(101)]
+    #[sampler(102)]
+    pub color: Option<Handle<Image>>,
+    #[texture(103)]
+    #[sampler(104)]
+    pub normal: Option<Handle<Image>>,
+}
+
+impl MaterialExtension for TerrainSurface {
+    fn fragment_shader() -> ShaderRef {
+        SHADER.into()
+    }
+
+    fn prepass_fragment_shader() -> ShaderRef {
+        SHADER.into()
+    }
+
+    fn deferred_fragment_shader() -> ShaderRef {
+        SHADER.into()
+    }
+}
